# Copie para .env (local) ou ~/churn.env (EC2) e preencha. O .env real é ignorado pelo Git.
#
# DB_HOST:
#   - na EC2 da aplicação (mesma VPC): IP PRIVADO da churn-db-host (ex.: 172.31.19.112)
#   - na sua máquina (fora da AWS):    IP PÚBLICO da churn-db-host (muda a cada stop/start)
#   - docker compose local:            postgres
DB_HOST=172.31.19.112
DB_PORT=5432
DB_NAME=churn_db
DB_USER=postgres
DB_PASSWORD=troque-pela-senha-do-banco
