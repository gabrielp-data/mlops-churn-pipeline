# Copie para .env. Use uma senha longa, aleatória e URL-encoded na URL abaixo.
CHURN_DATA_PATH=data/churn.csv
CHURN_TRACKING_URI=sqlite:///mlflow.db
CHURN_CHAMPION_DIR=models/champion
CHURN_API_URL=http://127.0.0.1:8000
POSTGRES_PASSWORD=troque-esta-senha
